# Copy this file to .env, fill in the values below, then run:
#   npm run setup
#   npm start

NODE_ENV=production
PORT=1053
# Native loader authentication, module, and driver traffic uses a dedicated
# TCP port. Browser, Discord, and player HTTP stay on PORT.
CRISIS_NATIVE_PORT=223
# Forwarded HTTPS headers are trusted from loopback by default. If TLS terminates
# on another host, set only that proxy's exact IP address or CIDR.
# CRISIS_TRUST_PROXY=10.0.0.10


# Discord Developer Portal -> your application.
# The client/application ID and public key are identifiers, not secrets.
# Example ID format: 123456789012345678
DISCORD_CLIENT_ID=
DISCORD_PUBLIC_KEY=

# Discord Developer Portal -> Bot -> Reset Token.
# This is secret. Never send it to customers or commit your .env file.
DISCORD_BOT_TOKEN=

# Your Discord server ID and the role IDs allowed to use admin commands.
# Multiple admin roles can be separated with commas.
# Example: DISCORD_ADMIN_ROLE_IDS=123456789012345678,234567890123456789
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_IDS=

# Discord user IDs allowed to use administrator commands in DMs or through a
# user-installed app. This is required for admin access outside the server.
# Example: DISCORD_ADMIN_USER_IDS=123456789012345678,234567890123456789
DISCORD_ADMIN_USER_IDS=

# Initial web-admin login. Run `npm run setup` once, then erase the
# ADMIN_PASSWORD value from .env. Only its scrypt hash remains in the database.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_USE_A_UNIQUE_PASSWORD

# Per-player casino request throttling. Outcomes and balances always remain on
# the server; these values only control abuse protection.
CRISIS_CASINO_RATE_WINDOW_MS=10000
CRISIS_CASINO_RATE_MAX=30
# Required when starting the server. Use an absolute path outside the application
# checkout so source deployments and restarts cannot select or replace another
# license database. Run `npm run migrate` once to initialize a new path.
DATABASE_PATH=/var/lib/crisis-auth/database.json
